# Copia este archivo como .env (desarrollo) o define estas variables en Render / GitHub Actions.
ENV=development
# PostgreSQL local:      postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/ligamx
# Neon (producción):     postgresql+psycopg://USUARIO:CLAVE@HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ligamx
# Token largo y aleatorio para las rutas /api/admin (vacío = administración deshabilitada).
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173
# Opcionales
# SYNC_DAYS_BACK=4
# SYNC_DAYS_AHEAD=60
# STALE_AFTER_MINUTES=30
# HTTP_MIN_INTERVAL_S=0.4
